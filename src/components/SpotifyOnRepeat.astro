---
import spotify from '../data/spotify.json';

const tracks = spotify.tracks ?? [];
const updated = spotify.updatedAt
  ? new Intl.DateTimeFormat('en-US', {
      day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
    }).format(new Date(spotify.updatedAt))
  : null;
---

{tracks.length > 0 && (
  <section class="spotify-section" aria-label="Spotify top tracks">
    <ol class="spotify-list">
      {tracks.map((track) => (
        <li>
          <a class="spotify-track" href={track.url} target="_blank" rel="noopener noreferrer"
            aria-label={`Listen to ${track.title} by ${track.artist} on Spotify`}>
            {track.image ? (
              <img class="spotify-cover" src={track.image} width="48" height="48"
                alt="" loading="lazy" decoding="async" />
            ) : (
              <span class="spotify-cover spotify-cover-fallback" aria-hidden="true">♫</span>
            )}
            <span class="spotify-track-info">
              <span class="spotify-track-name">{track.title}</span>
              <span class="spotify-artist">{track.artist}</span>
            </span>
            <span class="spotify-track-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ol>
    <div class="spotify-attribution">
      <span>{updated ? `Updated ${updated}` : 'Updated daily'}</span>
      <a href="https://open.spotify.com/" target="_blank" rel="noopener noreferrer">
        <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="11" fill="currentColor" />
          <path d="M5.8 9.1c4.7-1.4 9.8-.8 13.5 1.3M6.9 12.5c4-1.1 8.4-.6 11.5 1.2M7.8 15.7c3.3-.8 6.7-.4 9.3 1" fill="none" stroke="var(--bg)" stroke-width="1.65" stroke-linecap="round"/>
        </svg>
        <span>Listen on Spotify</span>
      </a>
    </div>
  </section>
)}
